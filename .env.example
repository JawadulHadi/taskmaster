GOOGLE_CLOUD_PROJECT=
MEILI_API_KEY=
MEILI_HOST=
PUBSUB_TOPIC=
GEMINI_API_KEY=

# Full HTTPS URL of this service's /tasks/run endpoint once deployed to
# Cloud Run — required to verify Pub/Sub push OIDC tokens. Leave unset for
# local dev (auth check is skipped with a warning, not silently bypassed).
PUBSUB_PUSH_AUDIENCE=

PORT=3000
